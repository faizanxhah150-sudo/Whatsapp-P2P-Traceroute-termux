# Copy to .env and adjust. All optional - defaults work out of the box.
# Relative paths are resolved against the project root (not the current directory).

# GeoLite2 databases (free MaxMind account: https://www.maxmind.com/en/geolite2/signup)
GEO_CITY_DB=data/GeoLite2-City.mmdb
GEO_ASN_DB=data/GeoLite2-ASN.mmdb

# Capture
# auto = native AF_PACKET, then tcpdump pipe (Scapy only on Windows/macOS). Or: afpacket | tcpdump | scapy
WIT_BACKEND=auto
# Blank = auto-detect (wlan0, then cellular ccmni*/rmnet*). Examples: wlan0, ccmni1, ap0
WIT_IFACE=
WIT_COUNT=0
# Kernel BPF is tried first; if tcpdump/BPF is unavailable a Python-side fallback is used.
# Empty value disables the capture filter.
WIT_BPF=udp or tcp
WIT_RANGE_MAX_AGE=24

# Copy reports + pcap here after each run (Android: /sdcard/WhatsAppP2P)
WIT_EXPORT_DIR=

# Network / DNS behaviour
WIT_HTTP_CONNECT_TIMEOUT=5
WIT_HTTP_READ_TIMEOUT=15
WIT_HTTP_RETRIES=3
WIT_RDNS=1
WIT_RDNS_TIMEOUT=2
WIT_MAX_RECORDS=20000

# Dashboard (open http://127.0.0.1:8000 in the phone browser)
WIT_HOST=127.0.0.1
WIT_PORT=8000
